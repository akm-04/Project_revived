diff --git a/internal/adapters/postgres/i5store/player_type_test.go b/internal/adapters/postgres/i5store/player_type_test.go
new file mode 100644
index 0000000..5e1a56a
--- /dev/null
+++ b/internal/adapters/postgres/i5store/player_type_test.go
@@ -0,0 +1,48 @@
+package i5store
+
+import (
+	"context"
+	"testing"
+
+	"gxb.local/backend/v2/internal/adapters/postgres/kernelstore"
+	"gxb.local/backend/v2/internal/domain/identity"
+	"gxb.local/backend/v2/internal/foundation/tx"
+)
+
+type playerTypeQueryer struct{ row tx.Row }
+
+func (q playerTypeQueryer) QueryRow(context.Context, string, ...any) tx.Row { return q.row }
+
+type playerTypeRow struct {
+	pid int64
+	typ int64
+	err error
+}
+
+func (r playerTypeRow) Scan(dest ...any) error {
+	if r.err != nil {
+		return r.err
+	}
+	*(dest[0].(*int64)) = r.pid
+	*(dest[1].(*int64)) = r.typ
+	return nil
+}
+
+func TestPlayerTypeReadPreservesCanonicalInt64WithoutRangeInference(t *testing.T) {
+	s := Store{Queryer: playerTypeQueryer{row: playerTypeRow{pid: 100001, typ: -9}}}
+	got, ok, err := s.PlayerType(context.Background(), identity.PlayerID(100001))
+	if err != nil || !ok || got != -9 {
+		t.Fatalf("got=%d ok=%v err=%v", got, ok, err)
+	}
+}
+
+func TestPlayerTypeReadMissingAndOwnerMismatchFailClosed(t *testing.T) {
+	s := Store{Queryer: playerTypeQueryer{row: playerTypeRow{err: kernelstore.ErrNoRows}}}
+	if got, ok, err := s.PlayerType(context.Background(), identity.PlayerID(100001)); err != nil || ok || got != 0 {
+		t.Fatalf("missing got=%d ok=%v err=%v", got, ok, err)
+	}
+	s = Store{Queryer: playerTypeQueryer{row: playerTypeRow{pid: 100002, typ: 3}}}
+	if _, ok, err := s.PlayerType(context.Background(), identity.PlayerID(100001)); err == nil || ok {
+		t.Fatalf("owner mismatch ok=%v err=%v", ok, err)
+	}
+}
diff --git a/internal/adapters/postgres/i5store/store.go b/internal/adapters/postgres/i5store/store.go
index 4f91f4f..50bd48a 100644
--- a/internal/adapters/postgres/i5store/store.go
+++ b/internal/adapters/postgres/i5store/store.go
@@ -938,3 +938,25 @@ func (Store) LockPlayerLevelTx(ctx context.Context, t tx.Tx, pid identity.Player
 	}
 	return p.Level, nil
 }
+
+// PlayerType exposes the narrow I5-owned presentation read required by I7A.
+// It deliberately returns the canonical int64 verbatim; no source-qualified
+// PlayerType range exists in the active contract.
+func (s Store) PlayerType(ctx context.Context, pid identity.PlayerID) (int64, bool, error) {
+	if s.Queryer == nil || !pid.Valid() {
+		return 0, false, errors.New("invalid player type read")
+	}
+	var rawPID int64
+	var playerType int64
+	err := s.Queryer.QueryRow(ctx, `SELECT player_id,player_type FROM player_profiles WHERE player_id=$1`, int64(pid)).Scan(&rawPID, &playerType)
+	if noRows(err) {
+		return 0, false, nil
+	}
+	if err != nil {
+		return 0, false, err
+	}
+	if identity.PlayerID(rawPID) != pid {
+		return 0, false, errors.New("player type owner mismatch")
+	}
+	return playerType, true, nil
+}
diff --git a/internal/adapters/postgres/realtime_wakeup.go b/internal/adapters/postgres/realtime_wakeup.go
new file mode 100644
index 0000000..f6f25d4
--- /dev/null
+++ b/internal/adapters/postgres/realtime_wakeup.go
@@ -0,0 +1,75 @@
+//go:build postgres
+
+package postgres
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+	appwakeup "gxb.local/backend/v2/internal/application/realtimewakeup"
+)
+
+type pgWakeupFactory struct{ pool *Pool }
+
+func (f pgWakeupFactory) Acquire(ctx context.Context) (wakeupSession, error) {
+	if f.pool == nil || f.pool.raw == nil {
+		return nil, errors.New("nil PostgreSQL pool for realtime wakeup listener")
+	}
+	conn, err := f.pool.raw.Acquire(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return &pgWakeupSession{conn: conn}, nil
+}
+
+type pgWakeupSession struct{ conn *pgxpool.Conn }
+
+func (s *pgWakeupSession) Listen(ctx context.Context) error {
+	if s == nil || s.conn == nil {
+		return errors.New("nil realtime wakeup session")
+	}
+	_, err := s.conn.Exec(ctx, `LISTEN gxb1_realtime_wakeup_v1`)
+	return normalize(err)
+}
+func (s *pgWakeupSession) Wait(ctx context.Context) (string, error) {
+	if s == nil || s.conn == nil {
+		return "", errors.New("nil realtime wakeup session")
+	}
+	n, err := s.conn.Conn().WaitForNotification(ctx)
+	if err != nil {
+		return "", normalize(err)
+	}
+	if n.Channel != RealtimeWakeupChannel {
+		return "", fmt.Errorf("unexpected realtime wakeup channel %q", n.Channel)
+	}
+	return n.Payload, nil
+}
+func (s *pgWakeupSession) Close() {
+	if s != nil && s.conn != nil {
+		s.conn.Release()
+		s.conn = nil
+	}
+}
+
+// RealtimeWakeupListener uses an independently acquired PostgreSQL session. It
+// never borrows RealtimeOwnerGuard.conn and therefore cannot alter advisory-lock
+// ownership semantics.
+type RealtimeWakeupListener struct {
+	Pool       *Pool
+	Registry   appwakeup.Registry
+	RetryDelay time.Duration
+}
+
+func (l RealtimeWakeupListener) Run(ctx context.Context) error {
+	delay := l.RetryDelay
+	if delay == 0 {
+		delay = DefaultRealtimeWakeupRetryDelay
+	}
+	if delay < 0 {
+		return errors.New("negative realtime wakeup retry delay")
+	}
+	return runRealtimeWakeupListener(ctx, pgWakeupFactory{pool: l.Pool}, l.Registry, delay)
+}
diff --git a/internal/adapters/postgres/realtime_wakeup_core.go b/internal/adapters/postgres/realtime_wakeup_core.go
new file mode 100644
index 0000000..563d8fe
--- /dev/null
+++ b/internal/adapters/postgres/realtime_wakeup_core.go
@@ -0,0 +1,102 @@
+package postgres
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	appwakeup "gxb.local/backend/v2/internal/application/realtimewakeup"
+	"gxb.local/backend/v2/internal/foundation/tx"
+)
+
+// RealtimeWakeupChannel is a V2 mechanism namespace, not recovered gameplay
+// truth. No production route is activated by I7A-2 merely because this channel
+// and listener foundation exist.
+const RealtimeWakeupChannel = "gxb1_realtime_wakeup_v1"
+
+const DefaultRealtimeWakeupRetryDelay = 250 * time.Millisecond
+
+// EmitRealtimeWakeup emits only a bounded reference envelope. Passing the
+// caller-owned transaction Execer preserves PostgreSQL's commit-coupled NOTIFY
+// behavior when a future owner emits after its canonical state mutation.
+func EmitRealtimeWakeup(ctx context.Context, exec tx.Execer, e appwakeup.Envelope) error {
+	if exec == nil {
+		return errors.New("nil realtime wakeup execer")
+	}
+	payload, err := e.Encode()
+	if err != nil {
+		return err
+	}
+	_, err = exec.Exec(ctx, `SELECT pg_notify($1,$2)`, RealtimeWakeupChannel, string(payload))
+	return err
+}
+
+type wakeupSession interface {
+	Listen(context.Context) error
+	Wait(context.Context) (string, error)
+	Close()
+}
+
+type wakeupFactory interface {
+	Acquire(context.Context) (wakeupSession, error)
+}
+
+func runRealtimeWakeupListener(ctx context.Context, factory wakeupFactory, registry appwakeup.Registry, retryDelay time.Duration) error {
+	if factory == nil || retryDelay < 0 {
+		return errors.New("invalid realtime wakeup listener configuration")
+	}
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		session, err := factory.Acquire(ctx)
+		if err == nil {
+			retry, runErr := consumeRealtimeWakeups(ctx, session, registry)
+			session.Close()
+			if !retry {
+				return runErr
+			}
+			err = runErr
+		}
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if retryDelay == 0 {
+			continue
+		}
+		t := time.NewTimer(retryDelay)
+		select {
+		case <-ctx.Done():
+			if !t.Stop() {
+				<-t.C
+			}
+			return ctx.Err()
+		case <-t.C:
+		}
+	}
+}
+
+// consumeRealtimeWakeups returns retry=true only for connection/listener loss.
+// Malformed/unknown route input fails closed to the caller rather than being
+// silently discarded as if canonical delivery had succeeded.
+func consumeRealtimeWakeups(ctx context.Context, session wakeupSession, registry appwakeup.Registry) (bool, error) {
+	if session == nil {
+		return true, errors.New("nil realtime wakeup session")
+	}
+	if err := session.Listen(ctx); err != nil {
+		return true, err
+	}
+	for {
+		payload, err := session.Wait(ctx)
+		if err != nil {
+			return true, err
+		}
+		e, err := appwakeup.Decode([]byte(payload))
+		if err != nil {
+			return false, err
+		}
+		if err := registry.Dispatch(ctx, e); err != nil {
+			return false, err
+		}
+	}
+}
diff --git a/internal/adapters/postgres/realtime_wakeup_test.go b/internal/adapters/postgres/realtime_wakeup_test.go
new file mode 100644
index 0000000..b603014
--- /dev/null
+++ b/internal/adapters/postgres/realtime_wakeup_test.go
@@ -0,0 +1,143 @@
+package postgres
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	appwakeup "gxb.local/backend/v2/internal/application/realtimewakeup"
+	"gxb.local/backend/v2/internal/foundation/tx"
+)
+
+type fakeWakeupFactory struct {
+	mu       sync.Mutex
+	sessions []wakeupSession
+	acquires int
+}
+
+func (f *fakeWakeupFactory) Acquire(context.Context) (wakeupSession, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.acquires++
+	if len(f.sessions) == 0 {
+		return nil, errors.New("no fake session")
+	}
+	s := f.sessions[0]
+	f.sessions = f.sessions[1:]
+	return s, nil
+}
+
+type fakeWakeupSession struct {
+	listenErr error
+	payloads  []string
+	waitErr   error
+	closed    bool
+}
+
+func (s *fakeWakeupSession) Listen(context.Context) error { return s.listenErr }
+func (s *fakeWakeupSession) Wait(context.Context) (string, error) {
+	if len(s.payloads) > 0 {
+		p := s.payloads[0]
+		s.payloads = s.payloads[1:]
+		return p, nil
+	}
+	if s.waitErr != nil {
+		return "", s.waitErr
+	}
+	return "", context.Canceled
+}
+func (s *fakeWakeupSession) Close() { s.closed = true }
+
+func encodedWakeup(t *testing.T, route, ref string) string {
+	t.Helper()
+	b, err := (appwakeup.Envelope{Version: 1, Route: route, Ref: ref}).Encode()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(b)
+}
+
+func TestRealtimeWakeupListenerReconnectsConnectionLossThenDispatchesCanonicalReloadRoute(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	lost := errors.New("connection lost")
+	s1 := &fakeWakeupSession{waitErr: lost}
+	s2 := &fakeWakeupSession{payloads: []string{encodedWakeup(t, "social.friend", "p:7")}, waitErr: context.Canceled}
+	factory := &fakeWakeupFactory{sessions: []wakeupSession{s1, s2}}
+	var got string
+	registry, err := appwakeup.NewRegistry(appwakeup.Registration{Route: "social.friend", Handler: appwakeup.RouteHandlerFunc(func(_ context.Context, ref string) error {
+		got = ref
+		cancel()
+		return nil
+	})})
+	if err != nil {
+		t.Fatal(err)
+	}
+	err = runRealtimeWakeupListener(ctx, factory, registry, 0)
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("run err=%v", err)
+	}
+	if got != "p:7" || factory.acquires != 2 || !s1.closed || !s2.closed {
+		t.Fatalf("got=%q acquires=%d closed1=%v closed2=%v", got, factory.acquires, s1.closed, s2.closed)
+	}
+}
+
+func TestRealtimeWakeupListenerFailsClosedOnUnknownRouteWithoutReconnectLoop(t *testing.T) {
+	empty, _ := appwakeup.NewRegistry()
+	s := &fakeWakeupSession{payloads: []string{encodedWakeup(t, "unknown.route", "x")}}
+	factory := &fakeWakeupFactory{sessions: []wakeupSession{s}}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	err := runRealtimeWakeupListener(ctx, factory, empty, 0)
+	if !errors.Is(err, appwakeup.ErrUnknownRoute) {
+		t.Fatalf("err=%v", err)
+	}
+	if factory.acquires != 1 || !s.closed {
+		t.Fatalf("acquires=%d closed=%v", factory.acquires, s.closed)
+	}
+}
+
+type wakeupCommandTag struct{}
+
+func (wakeupCommandTag) RowsAffected() int64 { return 1 }
+
+type wakeupExecer struct {
+	query string
+	args  []any
+	calls int
+	err   error
+}
+
+func (e *wakeupExecer) Exec(_ context.Context, query string, args ...any) (tx.CommandTag, error) {
+	e.calls++
+	e.query = query
+	e.args = append([]any(nil), args...)
+	return wakeupCommandTag{}, e.err
+}
+
+func TestEmitRealtimeWakeupUsesCallerExecerAndReferenceEnvelopeOnly(t *testing.T) {
+	exec := &wakeupExecer{}
+	envelope := appwakeup.Envelope{Version: appwakeup.EnvelopeVersion, Route: "social.friend", Ref: "p:7"}
+	if err := EmitRealtimeWakeup(context.Background(), exec, envelope); err != nil {
+		t.Fatal(err)
+	}
+	if exec.calls != 1 || exec.query != `SELECT pg_notify($1,$2)` || len(exec.args) != 2 || exec.args[0] != RealtimeWakeupChannel {
+		t.Fatalf("unexpected pg_notify call calls=%d query=%q args=%#v", exec.calls, exec.query, exec.args)
+	}
+	payload, ok := exec.args[1].(string)
+	if !ok {
+		t.Fatalf("payload type=%T", exec.args[1])
+	}
+	got, err := appwakeup.Decode([]byte(payload))
+	if err != nil || got != envelope {
+		t.Fatalf("decoded=%+v err=%v", got, err)
+	}
+	if err := EmitRealtimeWakeup(context.Background(), exec, appwakeup.Envelope{Version: 99, Route: "social.friend", Ref: "p:7"}); !errors.Is(err, appwakeup.ErrInvalidEnvelope) {
+		t.Fatalf("invalid envelope err=%v", err)
+	}
+	if exec.calls != 1 {
+		t.Fatalf("invalid envelope reached execer calls=%d", exec.calls)
+	}
+}
diff --git a/internal/adapters/stockruntime/realtime_publisher.go b/internal/adapters/stockruntime/realtime_publisher.go
new file mode 100644
index 0000000..b22b290
--- /dev/null
+++ b/internal/adapters/stockruntime/realtime_publisher.go
@@ -0,0 +1,62 @@
+package stockruntime
+
+import (
+	"context"
+	"errors"
+
+	"gxb.local/backend/v2/internal/protocol/limits"
+	wireRT "gxb.local/backend/v2/internal/protocol/realtime"
+)
+
+var ErrInvalidRealtimePublicationHandle = errors.New("invalid realtime publication handle")
+
+// RealtimePublisher is the protocol/adapter-edge publisher. It validates wire
+// schema and physical role before using the existing per-socket writer handle.
+// It owns no gameplay truth and contains no durable retry queue.
+type RealtimePublisher struct {
+	Registry wireRT.EventRegistry
+	Limits   limits.Config
+}
+
+func (p RealtimePublisher) config() (limits.Config, error) {
+	cfg := p.Limits
+	if cfg.RealtimeBufferedBytes == 0 {
+		cfg = limits.Default()
+	}
+	if err := cfg.Validate(); err != nil {
+		return limits.Config{}, err
+	}
+	return cfg, nil
+}
+
+func (p RealtimePublisher) PublishDirect(ctx context.Context, h SessionHandle, mid uint16, params any) error {
+	meta, ok := h.Metadata()
+	if !ok {
+		return ErrInvalidRealtimePublicationHandle
+	}
+	role := protocolRole(meta.PhysicalRole)
+	if err := p.Registry.ValidateDirect(mid, role, params); err != nil {
+		return err
+	}
+	cfg, err := p.config()
+	if err != nil {
+		return err
+	}
+	return h.Send(ctx, wireRT.Frame{MID: mid, Sequence: 0, Params: params}, cfg)
+}
+
+func (p RealtimePublisher) PublishNotice(ctx context.Context, h SessionHandle, parent uint16, namespace wireRT.NoticeNamespace, params any) error {
+	meta, ok := h.Metadata()
+	if !ok {
+		return ErrInvalidRealtimePublicationHandle
+	}
+	role := protocolRole(meta.PhysicalRole)
+	if err := p.Registry.ValidateNotice(parent, namespace, role, params); err != nil {
+		return err
+	}
+	cfg, err := p.config()
+	if err != nil {
+		return err
+	}
+	return h.Send(ctx, wireRT.Frame{MID: parent, Sequence: 0, Params: params}, cfg)
+}
diff --git a/internal/adapters/stockruntime/realtime_publisher_test.go b/internal/adapters/stockruntime/realtime_publisher_test.go
new file mode 100644
index 0000000..147feb2
--- /dev/null
+++ b/internal/adapters/stockruntime/realtime_publisher_test.go
@@ -0,0 +1,77 @@
+package stockruntime
+
+import (
+	"context"
+	"errors"
+	"net"
+	"testing"
+	"time"
+
+	domainrt "gxb.local/backend/v2/internal/domain/realtimeauth"
+	"gxb.local/backend/v2/internal/protocol/amf3"
+	"gxb.local/backend/v2/internal/protocol/limits"
+	"gxb.local/backend/v2/internal/protocol/mids"
+	wireRT "gxb.local/backend/v2/internal/protocol/realtime"
+)
+
+func TestRealtimePublisherValidatesBeforeUsingExistingWriter(t *testing.T) {
+	reg, err := wireRT.NewEventRegistry([]wireRT.DirectRegistration{{
+		MID: mids.MIDChatFromPlayer, Roles: []wireRT.Role{wireRT.World}, Validate: wireRT.RequireAMF3Object,
+	}}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	publisher := RealtimePublisher{Registry: reg, Limits: limits.Default()}
+	connections := NewConnectionRegistry()
+	admission := registryAdmission(t, "33333333-3333-4333-8333-333333333333", 100001, domainrt.World, 1)
+	server, client := net.Pipe()
+	defer client.Close()
+	writer, err := newConnWriter(context.Background(), server, limits.Default(), time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	h, err := connections.Replace(admission, writer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer connections.Remove(h)
+
+	if err := publisher.PublishDirect(context.Background(), h, mids.MIDChatFromFriend, &amf3.Object{}); !errors.Is(err, wireRT.ErrUnknownS2CSchema) {
+		t.Fatalf("unregistered publication err=%v", err)
+	}
+
+	readDone := make(chan wireRT.Frame, 1)
+	readErr := make(chan error, 1)
+	go func() {
+		buf := make([]byte, 4096)
+		n, err := client.Read(buf)
+		if err != nil {
+			readErr <- err
+			return
+		}
+		dec, _ := wireRT.NewStreamDecoder(limits.Default())
+		frames, err := dec.Feed(buf[:n])
+		if err != nil || len(frames) != 1 {
+			if err == nil {
+				err = errors.New("unexpected frame count")
+			}
+			readErr <- err
+			return
+		}
+		readDone <- frames[0]
+	}()
+	payload := &amf3.Object{Properties: []amf3.Property{{Name: "player_id", Value: 100001.0}}}
+	if err := publisher.PublishDirect(context.Background(), h, mids.MIDChatFromPlayer, payload); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case f := <-readDone:
+		if f.MID != mids.MIDChatFromPlayer {
+			t.Fatalf("published MID=%d", f.MID)
+		}
+	case err := <-readErr:
+		t.Fatal(err)
+	case <-time.After(time.Second):
+		t.Fatal("publication not written")
+	}
+}
diff --git a/internal/adapters/stockruntime/realtime_registry.go b/internal/adapters/stockruntime/realtime_registry.go
new file mode 100644
index 0000000..9ad7274
--- /dev/null
+++ b/internal/adapters/stockruntime/realtime_registry.go
@@ -0,0 +1,275 @@
+package stockruntime
+
+import (
+	"context"
+	"errors"
+	"net"
+	"sort"
+	"sync"
+
+	"gxb.local/backend/v2/internal/domain/identity"
+	domainrt "gxb.local/backend/v2/internal/domain/realtimeauth"
+	"gxb.local/backend/v2/internal/protocol/limits"
+	wireRT "gxb.local/backend/v2/internal/protocol/realtime"
+)
+
+var (
+	ErrRealtimeSessionRetired = errors.New("realtime session handle retired")
+	ErrInvalidRealtimeSession = errors.New("invalid realtime session registration")
+)
+
+type registryKey struct {
+	Context identity.ContextID
+	Role    domainrt.PhysicalRole
+}
+
+type playerRoleKey struct {
+	Player identity.PlayerID
+	Role   domainrt.PhysicalRole
+}
+
+type roomRoleKey struct {
+	Room int64
+	Role domainrt.PhysicalRole
+}
+
+// SessionMetadata is the immutable admission/liveness snapshot attached to one
+// physical realtime socket generation. It is routing evidence only; canonical
+// gameplay and identity truth remain with their existing owners.
+type SessionMetadata struct {
+	AccountID              identity.AccountID
+	AccountUID             identity.AccountUID
+	SessionID              identity.SessionID
+	ContextID              identity.ContextID
+	LogicalServerID        identity.LogicalServerID
+	PlayerID               identity.PlayerID
+	ContextGeneration      int64
+	SessionLivenessVersion int64
+	ContextLivenessVersion int64
+	PhysicalRole           domainrt.PhysicalRole
+	RoomID                 int64
+	RegistryGeneration     uint64
+}
+
+func (m SessionMetadata) valid() bool {
+	return !m.AccountID.UUID().IsZero() && m.AccountUID.Valid() && !m.SessionID.UUID().IsZero() &&
+		!m.ContextID.UUID().IsZero() && m.LogicalServerID.Valid() && m.PlayerID.Valid() &&
+		m.ContextGeneration > 0 && m.SessionLivenessVersion > 0 && m.ContextLivenessVersion > 0 &&
+		m.PhysicalRole.Valid() && m.RoomID > 0 && m.RegistryGeneration > 0
+}
+
+type registrySession struct {
+	meta   SessionMetadata
+	writer *connWriter
+	conn   net.Conn
+
+	lifecycle sync.Mutex
+	retired   bool
+}
+
+// SessionHandle is an immutable feature-facing publication capability. It never
+// exposes net.Conn or permits construction of another writer. A snapshotted
+// handle remains safe across replacement: once retirement linearizes, new Send
+// calls fail with ErrRealtimeSessionRetired.
+type SessionHandle struct{ session *registrySession }
+
+func (h SessionHandle) Valid() bool { return h.session != nil && h.session.meta.valid() }
+func (h SessionHandle) Metadata() (SessionMetadata, bool) {
+	if !h.Valid() {
+		return SessionMetadata{}, false
+	}
+	return h.session.meta, true
+}
+func (h SessionHandle) RegistryGeneration() uint64 {
+	if h.session == nil {
+		return 0
+	}
+	return h.session.meta.RegistryGeneration
+}
+func (h SessionHandle) Send(ctx context.Context, frame wireRT.Frame, cfg limits.Config) error {
+	if h.session == nil || h.session.writer == nil {
+		return ErrRealtimeSessionRetired
+	}
+	s := h.session
+	// The lifecycle mutex protects only admission into the existing writer
+	// queue. It is deliberately released before waiting for conn.Write so that
+	// retirement can close the private socket and interrupt blocked I/O.
+	s.lifecycle.Lock()
+	if s.retired {
+		s.lifecycle.Unlock()
+		return ErrRealtimeSessionRetired
+	}
+	done, err := s.writer.enqueue(ctx, frame, cfg)
+	s.lifecycle.Unlock()
+	if err != nil {
+		return err
+	}
+	return s.writer.await(ctx, done)
+}
+
+func (s *registrySession) retire() {
+	if s == nil {
+		return
+	}
+	s.lifecycle.Lock()
+	if s.retired {
+		s.lifecycle.Unlock()
+		return
+	}
+	s.retired = true
+	s.lifecycle.Unlock()
+
+	// Closing the socket first interrupts an in-progress/blocked writer. The
+	// writer owns every conn.Write; the registry only owns private teardown.
+	if s.conn != nil {
+		_ = s.conn.Close()
+	}
+	if s.writer != nil {
+		s.writer.Close()
+	}
+}
+
+// ConnectionRegistry is the process-local I4 index of admitted physical
+// realtime sockets. The authoritative primary identity remains context+role;
+// secondary indices are delivery projections and never collapse all contexts
+// for one player into a global winner.
+type ConnectionRegistry struct {
+	mu       sync.Mutex
+	next     uint64
+	by       map[registryKey]*registrySession
+	byPlayer map[playerRoleKey]map[uint64]*registrySession
+	byRoom   map[roomRoleKey]map[uint64]*registrySession
+}
+
+func NewConnectionRegistry() *ConnectionRegistry {
+	return &ConnectionRegistry{
+		by:       make(map[registryKey]*registrySession),
+		byPlayer: make(map[playerRoleKey]map[uint64]*registrySession),
+		byRoom:   make(map[roomRoleKey]map[uint64]*registrySession),
+	}
+}
+
+// Replace installs the newest generation for context+physical-role. Registry
+// mutation and index removal occur under r.mu; socket/writer teardown occurs
+// only after that mutex is released.
+func (r *ConnectionRegistry) Replace(admission domainrt.Admission, writer *connWriter) (SessionHandle, error) {
+	if r == nil || writer == nil || writer.conn == nil || !admission.Role.Valid() || admission.RoomID <= 0 {
+		return SessionHandle{}, ErrInvalidRealtimeSession
+	}
+	a := admission.Actor
+	if a.AccountID.UUID().IsZero() || !a.AccountUID.Valid() || a.SessionID.UUID().IsZero() || a.ContextID.UUID().IsZero() ||
+		!a.LogicalServerID.Valid() || !a.PlayerID.Valid() || a.ContextGeneration <= 0 || a.SessionLivenessVersion <= 0 || a.ContextLivenessVersion <= 0 {
+		return SessionHandle{}, ErrInvalidRealtimeSession
+	}
+
+	key := registryKey{Context: a.ContextID, Role: admission.Role}
+	var old *registrySession
+
+	r.mu.Lock()
+	r.next++
+	s := &registrySession{meta: SessionMetadata{
+		AccountID: a.AccountID, AccountUID: a.AccountUID, SessionID: a.SessionID, ContextID: a.ContextID,
+		LogicalServerID: a.LogicalServerID, PlayerID: a.PlayerID, ContextGeneration: a.ContextGeneration,
+		SessionLivenessVersion: a.SessionLivenessVersion, ContextLivenessVersion: a.ContextLivenessVersion,
+		PhysicalRole: admission.Role, RoomID: admission.RoomID, RegistryGeneration: r.next,
+	}, writer: writer, conn: writer.conn}
+	old = r.by[key]
+	if old != nil {
+		r.removeIndicesLocked(old)
+	}
+	r.by[key] = s
+	r.addIndicesLocked(s)
+	r.mu.Unlock()
+
+	if old != nil && old != s {
+		old.retire()
+	}
+	return SessionHandle{session: s}, nil
+}
+
+// Remove deletes only the exact generation represented by h. A stale ServeConn
+// defer cannot remove a newer replacement for the same context+role.
+func (r *ConnectionRegistry) Remove(h SessionHandle) {
+	if r == nil || h.session == nil {
+		return
+	}
+	s := h.session
+	key := registryKey{Context: s.meta.ContextID, Role: s.meta.PhysicalRole}
+	removed := false
+	r.mu.Lock()
+	if cur := r.by[key]; cur == s && cur.meta.RegistryGeneration == s.meta.RegistryGeneration {
+		delete(r.by, key)
+		r.removeIndicesLocked(s)
+		removed = true
+	}
+	r.mu.Unlock()
+	if removed {
+		s.retire()
+	}
+}
+
+func (r *ConnectionRegistry) ByPlayerRole(playerID identity.PlayerID, role domainrt.PhysicalRole) []SessionHandle {
+	if r == nil || !playerID.Valid() || !role.Valid() {
+		return nil
+	}
+	r.mu.Lock()
+	out := snapshotSessions(r.byPlayer[playerRoleKey{Player: playerID, Role: role}])
+	r.mu.Unlock()
+	return out
+}
+
+func (r *ConnectionRegistry) ByRoomRole(roomID int64, role domainrt.PhysicalRole) []SessionHandle {
+	if r == nil || roomID <= 0 || !role.Valid() {
+		return nil
+	}
+	r.mu.Lock()
+	out := snapshotSessions(r.byRoom[roomRoleKey{Room: roomID, Role: role}])
+	r.mu.Unlock()
+	return out
+}
+
+func (r *ConnectionRegistry) addIndicesLocked(s *registrySession) {
+	pk := playerRoleKey{Player: s.meta.PlayerID, Role: s.meta.PhysicalRole}
+	if r.byPlayer[pk] == nil {
+		r.byPlayer[pk] = make(map[uint64]*registrySession)
+	}
+	r.byPlayer[pk][s.meta.RegistryGeneration] = s
+	rk := roomRoleKey{Room: s.meta.RoomID, Role: s.meta.PhysicalRole}
+	if r.byRoom[rk] == nil {
+		r.byRoom[rk] = make(map[uint64]*registrySession)
+	}
+	r.byRoom[rk][s.meta.RegistryGeneration] = s
+}
+
+func (r *ConnectionRegistry) removeIndicesLocked(s *registrySession) {
+	pk := playerRoleKey{Player: s.meta.PlayerID, Role: s.meta.PhysicalRole}
+	if bucket := r.byPlayer[pk]; bucket != nil {
+		delete(bucket, s.meta.RegistryGeneration)
+		if len(bucket) == 0 {
+			delete(r.byPlayer, pk)
+		}
+	}
+	rk := roomRoleKey{Room: s.meta.RoomID, Role: s.meta.PhysicalRole}
+	if bucket := r.byRoom[rk]; bucket != nil {
+		delete(bucket, s.meta.RegistryGeneration)
+		if len(bucket) == 0 {
+			delete(r.byRoom, rk)
+		}
+	}
+}
+
+func snapshotSessions(in map[uint64]*registrySession) []SessionHandle {
+	if len(in) == 0 {
+		return nil
+	}
+	gens := make([]uint64, 0, len(in))
+	for gen := range in {
+		gens = append(gens, gen)
+	}
+	sort.Slice(gens, func(i, j int) bool { return gens[i] < gens[j] })
+	out := make([]SessionHandle, 0, len(gens))
+	for _, gen := range gens {
+		out = append(out, SessionHandle{session: in[gen]})
+	}
+	return out
+}
diff --git a/internal/adapters/stockruntime/realtime_registry_test.go b/internal/adapters/stockruntime/realtime_registry_test.go
new file mode 100644
index 0000000..4db8407
--- /dev/null
+++ b/internal/adapters/stockruntime/realtime_registry_test.go
@@ -0,0 +1,255 @@
+package stockruntime
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"gxb.local/backend/v2/internal/domain/identity"
+	domainrt "gxb.local/backend/v2/internal/domain/realtimeauth"
+	"gxb.local/backend/v2/internal/foundation/ids"
+	"gxb.local/backend/v2/internal/protocol/amf3"
+	"gxb.local/backend/v2/internal/protocol/limits"
+	"gxb.local/backend/v2/internal/protocol/mids"
+	wireRT "gxb.local/backend/v2/internal/protocol/realtime"
+)
+
+func registryAdmission(t *testing.T, contextUUID string, player identity.PlayerID, role domainrt.PhysicalRole, room int64) domainrt.Admission {
+	t.Helper()
+	accountUUID, err := ids.ParseUUID("11111111-1111-4111-8111-111111111111")
+	if err != nil {
+		t.Fatal(err)
+	}
+	sessionUUID, err := ids.ParseUUID("22222222-2222-4222-8222-222222222222")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctxUUID, err := ids.ParseUUID(contextUUID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	accountID, _ := identity.AccountIDFrom(accountUUID)
+	sessionID, _ := identity.SessionIDFrom(sessionUUID)
+	contextID, _ := identity.ContextIDFrom(ctxUUID)
+	return domainrt.Admission{Role: role, RoomID: room, Actor: identity.ActorContext{
+		AccountID: accountID, AccountUID: identity.AccountUID("20000007"), SessionID: sessionID,
+		ContextID: contextID, LogicalServerID: 1, PlayerID: player, ContextGeneration: 3,
+		SessionLivenessVersion: 4, ContextLivenessVersion: 5,
+	}}
+}
+
+func newRegistryPipeWriter(t *testing.T) (*connWriter, net.Conn, net.Conn) {
+	t.Helper()
+	server, client := net.Pipe()
+	w, err := newConnWriter(context.Background(), server, limits.Default(), time.Second)
+	if err != nil {
+		server.Close()
+		client.Close()
+		t.Fatal(err)
+	}
+	return w, server, client
+}
+
+func TestConnectionRegistryReplacementRetiresSnapshottedHandle(t *testing.T) {
+	r := NewConnectionRegistry()
+	admission := registryAdmission(t, "33333333-3333-4333-8333-333333333333", 100001, domainrt.World, 1)
+
+	w1, _, client1 := newRegistryPipeWriter(t)
+	defer client1.Close()
+	h1, err := r.Replace(admission, w1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	meta, ok := h1.Metadata()
+	if !ok || meta.PlayerID != 100001 || meta.PhysicalRole != domainrt.World || meta.RoomID != 1 || meta.RegistryGeneration == 0 {
+		t.Fatalf("bad metadata ok=%v meta=%+v", ok, meta)
+	}
+
+	w2, _, client2 := newRegistryPipeWriter(t)
+	defer client2.Close()
+	h2, err := r.Replace(admission, w2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if h2.RegistryGeneration() <= h1.RegistryGeneration() {
+		t.Fatalf("replacement generation old=%d new=%d", h1.RegistryGeneration(), h2.RegistryGeneration())
+	}
+	if err := h1.Send(context.Background(), wireRT.Frame{MID: mids.MIDChatRoomEntered, Params: &amf3.Object{}}, limits.Default()); !errors.Is(err, ErrRealtimeSessionRetired) {
+		t.Fatalf("stale handle send err=%v", err)
+	}
+	got := r.ByPlayerRole(100001, domainrt.World)
+	if len(got) != 1 || got[0].RegistryGeneration() != h2.RegistryGeneration() {
+		t.Fatalf("player index after replacement=%v", generations(got))
+	}
+
+	r.Remove(h1) // stale remover must not delete the replacement.
+	got = r.ByRoomRole(1, domainrt.World)
+	if len(got) != 1 || got[0].RegistryGeneration() != h2.RegistryGeneration() {
+		t.Fatalf("stale remove deleted replacement: %v", generations(got))
+	}
+	r.Remove(h2)
+	if got := r.ByPlayerRole(100001, domainrt.World); len(got) != 0 {
+		t.Fatalf("removed handle still indexed: %v", generations(got))
+	}
+	if err := h2.Send(context.Background(), wireRT.Frame{MID: mids.MIDChatRoomEntered, Params: &amf3.Object{}}, limits.Default()); !errors.Is(err, ErrRealtimeSessionRetired) {
+		t.Fatalf("removed handle send err=%v", err)
+	}
+}
+
+func TestConnectionRegistryKeepsSamePlayerAcrossContexts(t *testing.T) {
+	r := NewConnectionRegistry()
+	admissions := []domainrt.Admission{
+		registryAdmission(t, "33333333-3333-4333-8333-333333333331", 100001, domainrt.World, 1),
+		registryAdmission(t, "33333333-3333-4333-8333-333333333332", 100001, domainrt.World, 1),
+	}
+	var handles []SessionHandle
+	var clients []net.Conn
+	for _, admission := range admissions {
+		w, _, client := newRegistryPipeWriter(t)
+		h, err := r.Replace(admission, w)
+		if err != nil {
+			t.Fatal(err)
+		}
+		handles = append(handles, h)
+		clients = append(clients, client)
+	}
+	defer func() {
+		for _, c := range clients {
+			_ = c.Close()
+		}
+	}()
+	got := r.ByPlayerRole(100001, domainrt.World)
+	if len(got) != 2 {
+		t.Fatalf("same player contexts collapsed: %v", generations(got))
+	}
+	room := r.ByRoomRole(1, domainrt.World)
+	if len(room) != 2 {
+		t.Fatalf("room index=%v", generations(room))
+	}
+	if got[0].RegistryGeneration() >= got[1].RegistryGeneration() {
+		t.Fatalf("snapshot order is not stable: %v", generations(got))
+	}
+	r.Remove(handles[0])
+	if got := r.ByPlayerRole(100001, domainrt.World); len(got) != 1 || got[0].RegistryGeneration() != handles[1].RegistryGeneration() {
+		t.Fatalf("remaining player handles=%v", generations(got))
+	}
+	r.Remove(handles[1])
+}
+
+func TestConnectionRegistryReplacementInterruptsBlockedOldWriteWithoutHoldingRegistryMutex(t *testing.T) {
+	r := NewConnectionRegistry()
+	admission := registryAdmission(t, "33333333-3333-4333-8333-333333333333", 100001, domainrt.World, 1)
+	blocking := newBlockingWriteConn()
+	w1, err := newConnWriter(context.Background(), blocking, limits.Default(), time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	h1, err := r.Replace(admission, w1)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	sendDone := make(chan error, 1)
+	go func() {
+		sendDone <- h1.Send(context.Background(), wireRT.Frame{MID: mids.MIDChatRoomEntered, Params: &amf3.Object{}}, limits.Default())
+	}()
+	select {
+	case <-blocking.writeStarted:
+	case <-time.After(time.Second):
+		t.Fatal("old writer did not enter blocked write")
+	}
+
+	w2, _, client2 := newRegistryPipeWriter(t)
+	defer client2.Close()
+	replaceDone := make(chan struct{})
+	var h2 SessionHandle
+	var replaceErr error
+	go func() {
+		h2, replaceErr = r.Replace(admission, w2)
+		close(replaceDone)
+	}()
+
+	// The new generation must become observable without waiting for the blocked
+	// old conn.Write, proving the registry mutex is not held during retirement.
+	deadline := time.Now().Add(250 * time.Millisecond)
+	visible := false
+	for time.Now().Before(deadline) {
+		got := r.ByPlayerRole(100001, domainrt.World)
+		if len(got) == 1 && got[0].RegistryGeneration() > h1.RegistryGeneration() {
+			visible = true
+			break
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if !visible {
+		t.Fatal("new generation never became visible while old write was blocked")
+	}
+
+	// Retirement owns the private socket close, so replacement must interrupt
+	// that old blocked write and complete without an external release signal.
+	select {
+	case <-replaceDone:
+		if replaceErr != nil {
+			t.Fatal(replaceErr)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("replacement did not interrupt blocked old write")
+	}
+	select {
+	case err := <-sendDone:
+		if err == nil {
+			t.Fatal("retired blocked send unexpectedly succeeded")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("blocked old send did not terminate after retirement")
+	}
+	if err := h1.Send(context.Background(), wireRT.Frame{MID: mids.MIDChatRoomEntered, Params: &amf3.Object{}}, limits.Default()); !errors.Is(err, ErrRealtimeSessionRetired) {
+		t.Fatalf("stale handle post-retirement send err=%v", err)
+	}
+	r.Remove(h2)
+}
+
+func generations(in []SessionHandle) []uint64 {
+	out := make([]uint64, 0, len(in))
+	for _, h := range in {
+		out = append(out, h.RegistryGeneration())
+	}
+	return out
+}
+
+type blockingWriteConn struct {
+	writeStarted chan struct{}
+	releaseWrite chan struct{}
+	closed       chan struct{}
+	startOnce    sync.Once
+	closeOnce    sync.Once
+}
+
+func newBlockingWriteConn() *blockingWriteConn {
+	return &blockingWriteConn{writeStarted: make(chan struct{}), releaseWrite: make(chan struct{}), closed: make(chan struct{})}
+}
+func (c *blockingWriteConn) Read([]byte) (int, error) { return 0, io.EOF }
+func (c *blockingWriteConn) Write(p []byte) (int, error) {
+	c.startOnce.Do(func() { close(c.writeStarted) })
+	select {
+	case <-c.releaseWrite:
+		return len(p), nil
+	case <-c.closed:
+		return 0, net.ErrClosed
+	}
+}
+func (c *blockingWriteConn) Close() error                     { c.closeOnce.Do(func() { close(c.closed) }); return nil }
+func (c *blockingWriteConn) LocalAddr() net.Addr              { return registryDummyAddr("local") }
+func (c *blockingWriteConn) RemoteAddr() net.Addr             { return registryDummyAddr("remote") }
+func (c *blockingWriteConn) SetDeadline(time.Time) error      { return nil }
+func (c *blockingWriteConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *blockingWriteConn) SetWriteDeadline(time.Time) error { return nil }
+
+type registryDummyAddr string
+
+func (d registryDummyAddr) Network() string { return string(d) }
+func (d registryDummyAddr) String() string  { return string(d) }
