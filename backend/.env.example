# Never commit real credentials.
GXB_ENV=dev
GXB_LOG_LEVEL=info
GXB_POSTGRES_DSN=postgres://gxb:gxb@127.0.0.1:5432/gxb?sslmode=disable
GXB_HTTP_ADDR=127.0.0.1:8080
GXB_REALTIME_ADDR=127.0.0.1:9000

# Optional stock MID1 client-log upload endpoint. Empty disables upload honestly.
GXB_CLIENT_LOG_URL=
