# Copy outside the backend tree, restrict permissions, and insert real secrets.
# Never commit or archive the populated file.
GXB_DATABASE_URL=postgresql+psycopg://gxb_app@127.0.0.1:5432/gxb
GXB_DATABASE_SCHEMA=gxb
GXB_DATABASE_APPLICATION_NAME=gxb-http
GXB_DATABASE_POOL_SIZE=4
GXB_DATABASE_MAX_OVERFLOW=0
GXB_DATABASE_POOL_TIMEOUT=5

# Disposable integration-test database; never point this at production.
GXB_TEST_DATABASE_URL=postgresql+psycopg://gxb_test@127.0.0.1:5432/gxb_i0_test
