GXB_DATABASE_URL=postgresql+psycopg://gxb_app:CHANGE_ME@127.0.0.1:5432/gxb
GXB_DATABASE_SCHEMA=gxb
# Default/rollback stage is 1. Pass348 also proves explicit stages 2 and 4;
# run `bin/gxb-stack scale-preflight N` before changing this value.
GXB_HTTP_WORKERS=1
GXB_HTTP_THREADS=8
GXB_HTTP_BIND=unix:/run/gxb/http.sock
GXB_MAINTENANCE_FILE=/run/gxb/maintenance
GXB_SDK_PORT=5000
GXB_ENGINE_PORT=9000
GXB_CHAT_HOST=127.0.0.1
GXB_CHAT_PORT=9100
GXB_SESSION_ABSOLUTE_TTL_SECONDS=2592000
GXB_SESSION_IDLE_TTL_SECONDS=86400
GXB_SESSION_ACTIVITY_WRITE_SECONDS=60
