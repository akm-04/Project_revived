#!/usr/bin/env bash
set -euo pipefail
action="${1:-status}"
units=(gxb-http.service gxb-realtime.service gxb-scheduler.service)
case "$action" in
  preflight)
    exec /opt/gxb/backend/.venv/bin/python /opt/gxb/backend/tools/pass347_i8_cutover.py preflight
    ;;
  preflight-maintenance)
    exec /opt/gxb/backend/.venv/bin/python /opt/gxb/backend/tools/pass347_i8_cutover.py preflight --maintenance
    ;;
  scale-preflight)
    workers="${2:-}"
    if [[ -z "$workers" ]]; then
      echo "usage: $0 scale-preflight {1|2|4}" >&2
      exit 64
    fi
    exec /opt/gxb/backend/.venv/bin/python /opt/gxb/backend/tools/pass348_i9_scale_preflight.py --workers "$workers"
    ;;
  maintenance-start)
    /opt/gxb/backend/.venv/bin/python /opt/gxb/backend/tools/pass347_i8_cutover.py maintenance-on
    exec systemctl start "${units[@]}"
    ;;
  maintenance-off)
    exec /opt/gxb/backend/.venv/bin/python /opt/gxb/backend/tools/pass347_i8_cutover.py maintenance-off
    ;;
  start|stop|restart|status)
    exec systemctl "$action" "${units[@]}"
    ;;
  *)
    echo "usage: $0 {preflight|preflight-maintenance|scale-preflight|maintenance-start|maintenance-off|start|stop|restart|status}" >&2
    exit 64
    ;;
esac
