  "source_facts": [
    {
      "id": "MID_IDENTITIES",
      "classification": "SOURCE_FACT",
      "fact": "Current mid.lua binds 60 SKIN_ON, 61 SKIN_CANCEL, 68 UNLOCK_DYNAMIC_CARD, 69 SHOW_DYNAMIC_CARD, 1893 GET_PET_STYLE_FORM_ITEM, 1894 USE_PET_STYLE, 1895 CANCEL_PET_STYLE, and 2979 USE_ILLUSION_SKIN_ITEM."
    },
    {
      "id": "HERO_PRESENTATION_AXIS",
      "classification": "SOURCE_FACT",
      "fact": "Current NormalHero.getModelID honors illusion sentinel/explicit state while getOldModelID uses ordinary selected skin or current Hero model."
    },
    {
      "id": "HERO_COMBAT_SKILL_AXIS",
      "classification": "SOURCE_FACT",
      "fact": "Current BaseFighter.getModelID uses Hero.getModelID for displayed fighter model, while getSkillModelID uses Hero.getOldModelID and checkSkinSkillInfo matches skin-skill model against getSkillModelID."
    },
    {
      "id": "HERO_COMBAT_DIFFERENTIAL",
      "classification": "SOURCE_FACT_DIFFERENTIAL",
      "fact": "v1.164 BaseFighter has no getSkillModelID split and checkSkinSkillInfo compares skin-skill model against getModelID; current client therefore deliberately separates illusion-aware display model from ordinary-skin combat skill matching."
    },
    {
      "id": "LIVE68",
      "classification": "SOURCE_FACT",
      "fact": "MID68 request is model_id+partner_id; success consumes unlocked_dynamic_card and dynamic_card_state aligned arrays."
    },
    {
      "id": "LIVE69",
      "classification": "SOURCE_FACT",
      "fact": "MID69 request is model_id+partner_id+is_show; on success the client updates the matching local dynamic-card state and does not require returned semantic state."
    },
    {
      "id": "LIVE_NONBATTLE_CENSUS",
      "classification": "STRONG_INFERENCE_FROM_TREE_WIDE_SOURCE_SEARCH",
      "fact": "No current lib/battle consumer of dynamic_card_state or unlocked_dynamic_card was found; observed consumers are Hero/presentation/UI paths. This constrains current-client behavior but does not prove original-server motive."
    },
    {
      "id": "PET_STYLE_WIRE",
      "classification": "SOURCE_FACT",
      "fact": "MID1893 uses item_id and success active_style+pet_styles; MID1894 uses pet_id+style_id and success active_style; MID1895 uses pet_id and success state is unused while client locally clears active style."
    },
    {
      "id": "PET_STYLE_NONCOMBAT",
      "classification": "STRONG_INFERENCE_FROM_CURRENT_SOURCE",
      "fact": "Pet activeStyle/petStyles are home-style state; current Pet.getModelID is table/star-derived and no lib/battle active_style consumer was found."
    },
    {
      "id": "ILLUSION_WIRE",
      "classification": "SOURCE_FACT",
      "fact": "MID2979 request uses partner_id+item_id; success paths consume illusion_skin_id. Client expiry/cleanup may send item_id=0, but this does not establish a server scheduler."
    },
    {
      "id": "LIBRARY_BOUNDARY",
      "classification": "SOURCE_FACT_PLUS_ARCHITECTURE_INFERENCE",
      "fact": "MID835 SET_BOARD_HERO persists/returns board_partner, board_card and board_model_id through Library paths; current card/presentation selection consumes Hero appearance. Board persistence is therefore distinct from Character appearance ownership."
    },
    {
      "id": "PET_ATTRIBUTE_0_REACHABILITY",
      "classification": "STRONG_INFERENCE",
      "fact": "Current window table maps pet_attribute to PetAttributeWindow and WindowManager imports the registered class. Tree-wide search found no external PetAttributeWindow0 reference; its MID60/61 Pet ordinary-skin branch is retained source debris, not a reachable current-client mutation contract."
    }
  ],
